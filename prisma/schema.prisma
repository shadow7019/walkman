generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Walkman music catalog
model Track {
  id          String   @id @default(cuid())
  title       String
  artist      String
  album       String
  genre       String
  year        Int      @default(2024)
  durationSec Int
  cover       String // local path under /public (e.g. /covers/x.jpg) OR remote artwork URL
  audioFile   String   @default("") // local path under /public, empty for remote-streamed tracks
  qualityTier String   @default("HQ") // HQ | HI-FI | STANDARD
  bitrateKbps Int      @default(320)
  trackNo     Int      @default(0) // catalog order
  createdAt   DateTime @default(now())

  // Remote catalog (Audius network)
  source        String    @default("local") // local | audius
  audiusId      String?   @unique
  releaseDate   DateTime?
  playCount     Int       @default(0)
  favoriteCount Int       @default(0)
  permalink     String?

  playlistTracks PlaylistTrack[]
  likes          Like[]
  history        PlayHistory[]

  @@index([artist])
  @@index([album])
  @@index([genre])
  @@index([playCount])
  @@index([createdAt])
}

model Playlist {
  id           String   @id @default(cuid())
  name         String
  description  String?
  gradient     String   @default("from-amber-500 to-orange-700")
  importedFrom String? // e.g. "Spotify JSON", "Apple Music text", "CSV"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tracks PlaylistTrack[]

  @@index([updatedAt])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId])
}

model Like {
  id        String   @id @default(cuid())
  trackId   String   @unique
  createdAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model PlayHistory {
  id       String   @id @default(cuid())
  trackId  String
  playedAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([playedAt])
  @@index([trackId])
}

// Records each catalog sync run (auto-added new songs)
model SyncLog {
  id       String   @id @default(cuid())
  scope    String // genre name or "all"
  fetched  Int
  added    Int
  updated  Int
  syncedAt DateTime @default(now())

  @@index([syncedAt])
}
