generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Walkman music catalog — industry tracks from multiple public sources
model Track {
  id          String   @id @default(cuid())
  title       String
  artist      String
  album       String   @default("")
  genre       String   @default("Pop") // canonical genre
  rawGenre    String   @default("") // source's own genre label
  mood        String   @default("") // e.g. "Energetic", "Peaceful"
  language    String   @default("English") // song language (Hindi, Korean, Spanish, …)
  country     String   @default("") // storefront/scene origin, e.g. "IN", "KR"
  year        Int      @default(2024)
  durationMs  Int      @default(0)
  cover       String   @default("") // remote artwork URL
  source      String   @default("itunes") // audius | itunes | local
  sourceId    String   @default("") // external id at source
  streamUrl   String   @default("") // full-length stream endpoint (audius)
  previewUrl  String   @default("") // 30s high-quality preview (itunes)
  hasFull     Boolean  @default(false) // true = full-length stream available
  qualityTier String   @default("HQ") // HI-FI (320) | HQ (256) | STANDARD
  bitrateKbps Int      @default(256)
  explicit    Boolean  @default(false)
  playCount   Int      @default(0)
  favoriteCount Int    @default(0)
  permalink   String   @default("")
  releaseDate DateTime?
  trackNo     Int      @default(0)
  createdAt   DateTime @default(now())

  playlistTracks PlaylistTrack[]
  likes          Like[]
  history        PlayHistory[]

  @@unique([source, sourceId])
  @@index([artist])
  @@index([album])
  @@index([genre])
  @@index([mood])
  @@index([language])
  @@index([playCount])
  @@index([createdAt])
  @@index([title])
}

model Playlist {
  id           String   @id @default(cuid())
  name         String
  description  String   @default("")
  gradient     String   @default("from-emerald-500 to-teal-700")
  importedFrom String   @default("") // "Spotify", "Text list", "CSV", "m3u8"
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tracks PlaylistTrack[]

  @@index([updatedAt])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId])
}

model Like {
  id        String   @id @default(cuid())
  trackId   String   @unique
  createdAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)
}

model PlayHistory {
  id       String   @id @default(cuid())
  trackId  String
  msPlayed Int      @default(0)
  completed Boolean @default(false)
  hour     Int      @default(0) // hour of day 0-23
  playedAt DateTime @default(now())

  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([playedAt])
  @@index([trackId])
}

// Records each catalog sync run (auto-add new songs)
model SyncLog {
  id       String   @id @default(cuid())
  source   String // audius | itunes
  scope    String // genre name or "all" or "trending"
  fetched  Int
  added    Int
  updated  Int
  detail   String   @default("")
  syncedAt DateTime @default(now())

  @@index([syncedAt])
}
